# Bu dosyayı kopyalayıp ".env" adıyla kaydedin ve kendi değerlerinizi yazın.
# .env dosyası .gitignore'da olduğu için GitHub'a asla gönderilmez.

# MongoDB bağlantı adresi
DATABASE=mongodb://localhost:27017/kuyumcu

# JWT token imzalama anahtarı — uzun ve rastgele olmalı.
JWT_SECRET=buraya_uzun_ve_rastgele_bir_anahtar_yazin

# development | production
NODE_ENV=development

# Giden e-postalar (şifre sıfırlama) için — Resend servisi
RESEND_API=
APP_EMAIL=noreply@ornek.com
APP_BASE_URL=http://localhost:3000
