# Bu dosyayı kopyalayıp ".env" adıyla kaydedin:
#   cp .env.example .env
# .env dosyası .gitignore'da olduğu için GitHub'a asla gönderilmez.

# Backend API adresi (sonundaki / önemli)
VITE_BACKEND_SERVER=http://localhost:8888/

# Yüklenen dosyaların (logo, görsel) sunulduğu adres
VITE_FILE_BASE_URL=http://localhost:8888/

# Üretim ortamında true yapın
PROD=false
